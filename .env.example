# Whisper LRC Configuration
HOST=0.0.0.0
PORT=9500
MODEL_DIR=/models
WHISPER_MODEL=ggml-large-v3-turbo.bin
CPU_THREADS=8

# Queue & Memory Lifecycle
IDLE_VRAM_TTL_SECS=600
MAX_QUEUE_CAPACITY=32
CACHE_SIZE=500
CACHE_TTL_SECS=86400

# Vocal Isolation, DTW Alignment & Instrumental Break Markers
DEFAULT_ISOLATE=false
ISOLATION_TIMEOUT_SECS=240
WHISPER_DTW=true
INSERT_INSTRUMENTAL_BREAKS=true
INSTRUMENTAL_BREAK_OFFSET_MS=1500
INSTRUMENTAL_BREAK_MIN_GAP_MS=5000
